@startuml D1_Rede_Acesso
!theme materia
title Homelab — D1: Rede & Acesso\n(Como o tráfego entra — ZTNA, Bloqueios e IDS/IPS)

top to bottom direction
skinparam defaultTextAlignment center
skinparam nodesep 40
skinparam ranksep 55

cloud "Internet (WAN)\n[IP Público Dinâmico]" as wan
cloud "Rede Local (LAN)\n[${LAN_SUBNET}]" as lan

node "Router Principal" as router {
    card "Firewall (Sem Port Forwarding)\n[0 Incoming Active Ports]" as nat
}

node "Host [${SERVER_IP}]" as host {
    card "CrowdSec Firewall Bouncer\n[Bare-metal]\n[Filtra IPs Maliciosos no iptables]" as bouncer #Salmon
    card "Tailscale (ZTNA)\n[Bare-metal · Mesh VPN]\n[Conexão Outbound / DERP Fallback]" as vpn
    card "Nginx Proxy Manager\n[Docker · Portas host: 80, 443]\n[Único ponto de entrada HTTP/S]" as npm
    card "DuckDNS (DDNS)\n[Docker · Outbound only]" as ddns
    
    bouncer -> npm : "Tráfego Limpo flui para NPM"
}

wan --> router : "Tráfego Bloqueado"
router --> nat : "Drop"

vpn --> wan : "Hole Punching / DERP Relays\n(Túnel outbound)"

lan --> bouncer : "HTTP/S (80/443)\n(IP passa pela firewall antes do NPM)"
vpn --> bouncer : "Tráfego desencapsulado\n(passa pela firewall antes do NPM)"

ddns --> wan : "Atualiza registo DNS"

note right of bouncer
  Atua ao nível do Kernel.
  Consulta API do CrowdSec Container.
  Se o IP for malicioso = BLOCK.
  Se for seguro = Passa ao NPM.
end note

@enduml